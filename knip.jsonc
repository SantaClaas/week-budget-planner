{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Finds unused files, exports and dependencies (https://knip.dev). Its plugins read the entry
  // points from the Vite, Vitest, Playwright, drizzle-kit and oxlint configs.
  // index.html registers the service worker by its URL, which knip can't follow.
  // stryker.config.mjs names vitest.mutation.config.ts as text, which knip can't follow either.
  "entry": ["scripts/*.ts", "public/service-worker.js", "vitest.mutation.config.ts"],
  // System tools, not packages: build-shapes.ts compiles Google's Kotlin sources with java, and
  // build-transport.ts writes the transport's JavaScript with wasm-bindgen (crates/transport).
  "ignoreBinaries": ["java", "wasm-bindgen"],
}
