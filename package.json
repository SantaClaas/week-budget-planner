{
  "name": "week-budget-planner",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SantaClaas/week-budget-planner"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "test": "vitest run --configLoader native",
    "test:browser": "pnpm build && PW_DISABLE_TS_ESM=1 playwright test",
    "typecheck": "tsc -b && node scripts/check-must-use.ts",
    "lint": "oxlint",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "icons:fetch": "node scripts/build-iconset.ts --fetch",
    "icons": "node scripts/build-iconset.ts",
    "colors": "node scripts/build-colors.ts",
    "modules": "node scripts/build-module-graph.ts",
    "shapes": "node scripts/build-shapes.ts",
    "database:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@formatjs/intl-durationformat": "0.11.1",
    "@oddbird/popover-polyfill": "0.7.2",
    "@solidjs/web": "2.0.0-rc.14",
    "@tursodatabase/database-wasm": "0.8.3",
    "core-js": "3.50.0",
    "drizzle-orm": "1.0.0-rc.4",
    "nanoid": "6.0.2",
    "solid-js": "2.0.0-rc.14",
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@material/material-color-utilities": "0.3.0",
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "1.64.1",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@tursodatabase/database": "0.8.3",
    "@types/node": "26.6.5",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "svgo": "4.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
