# Cross-origin isolation is required for SharedArrayBuffer (@tursodatabase/database-wasm).
# Read by Netlify and Cloudflare Pages. GitHub Pages ignores this file; there public/service-worker.js adds the
# headers instead.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The <meta> policy in index.html covers the rest; frame-ancestors only works as a header.
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The service worker must never be served stale, or fixes take an extra visit to arrive.
/week-budget-planner/service-worker.js
  Cache-Control: no-cache

# Hashed build assets are immutable.
/week-budget-planner/assets/*
  Cache-Control: public, max-age=31536000, immutable
